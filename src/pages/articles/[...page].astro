---
/**
 * articles/[...page].astro — Paginated articles archive
 *
 * Routes:  /articles/          → page 1
 *          /articles/2/        → page 2
 *          /articles/3/        → page 3  …etc.
 *
 * The [...page] rest param catches both the empty segment (page 1)
 * and numeric segments (page 2+). Astro's paginate() fills page.url.prev
 * / page.url.next automatically.
 */
import BaseLayout        from '@layouts/BaseLayout.astro';
import ArticleCard       from '@components/ArticleCard.astro';
import NewsletterSection from '@components/NewsletterSection.astro';
import { buildCanonical } from '@utils/seo';
import { getCollection }  from 'astro:content';
import { SITE }           from '@data/site';
import type { GetStaticPathsOptions } from 'astro';

export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const articles = (await getCollection('articles', (e) => !e.data.draft))
    .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

  return paginate(articles, { pageSize: 9 });
}

const { page } = Astro.props;

// Canonical points to the current page's URL
const canonical = buildCanonical(page.url.current);

// ItemList schema — always lists the full page's items with correct positions
const itemListSchema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type':    'ItemList',
  name:       'Articles — ' + SITE.name,
  url:        SITE.url.replace(/\/$/, '') + page.url.current,
  itemListElement: page.data.map((article, i) => ({
    '@type':   'ListItem',
    position:  page.start + i + 1,   // 1-based, accounts for page offset
    url:       SITE.url.replace(/\/$/, '') + `/articles/${article.slug}/`,
    name:      article.data.title,
  })),
});

const isFirstPage = page.currentPage === 1;
const pageTitle   = isFirstPage ? 'Articles' : `Articles — Page ${page.currentPage}`;
---

<BaseLayout
  title={pageTitle}
  description="Expert guides, honest reviews, and lifestyle tips from Spoky Curates."
  canonical={canonical}
  schema={itemListSchema}
>

  <!-- ── Hero ─────────────────────────────────────────────── -->
  <section class="relative py-16 lg:py-24 bg-slate-900 text-white">
    <div class="container">
      <h1 class="font-serif text-4xl lg:text-5xl font-bold mb-4">
        Articles
      </h1>
      <p class="text-lg text-white/70 max-w-2xl">
        In-depth guides, trends, and smart living ideas — updated regularly.
      </p>
    </div>
  </section>

  <!-- ── Article grid ─────────────────────────────────────── -->
  <section class="section bg-white">
    <div class="container">
      {page.data.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {page.data.map((article) => (
            <ArticleCard entry={article} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-slate-500">No articles published yet. Check back soon.</p>
          <a href="/" class="btn-primary mt-6 inline-flex">Back to Home</a>
        </div>
      )}

      <!-- ── Pagination controls ──────────────────────────── -->
      {(page.url.prev || page.url.next) && (
        <nav
          class="flex items-center justify-between mt-12 pt-8 border-t border-slate-200"
          aria-label="Article pagination"
        >
          <!-- Prev -->
          <div>
            {page.url.prev ? (
              <a href={page.url.prev} class="btn btn-outline-dark" rel="prev">
                ← Previous
              </a>
            ) : (
              <span class="btn btn-outline-dark opacity-40 cursor-not-allowed" aria-disabled="true">
                ← Previous
              </span>
            )}
          </div>

          <!-- Page indicator -->
          <p class="text-sm text-slate-500">
            Page <strong class="text-slate-800">{page.currentPage}</strong>
            {' '}of{' '}
            <strong class="text-slate-800">{page.lastPage}</strong>
          </p>

          <!-- Next -->
          <div>
            {page.url.next ? (
              <a href={page.url.next} class="btn btn-outline-dark" rel="next">
                Next →
              </a>
            ) : (
              <span class="btn btn-outline-dark opacity-40 cursor-not-allowed" aria-disabled="true">
                Next →
              </span>
            )}
          </div>
        </nav>
      )}
    </div>
  </section>

  <NewsletterSection />

</BaseLayout>
