---
import BaseLayout        from '@layouts/BaseLayout.astro';
import { SITE }          from '@data/site';
import { buildCanonical }from '@utils/seo';
---

<BaseLayout
  title="Contact Spoky Curates"
  description={`Get in touch with the ${SITE.name} team. We'd love to hear from you.`}
  canonical={buildCanonical('/contact/')}
>
  <div class="container py-16 lg:py-24 max-w-2xl mx-auto">

    <h1 class="font-serif text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
      Contact Us
    </h1>
    <p class="text-lg text-slate-600 mb-12 leading-relaxed">
      Have a question, product suggestion, or partnership inquiry? Fill out the form
      below and we'll get back to you as soon as possible.
    </p>

    <!-- Contact form — handled by Formspree.
         1. Sign up at https://formspree.io and create a new form.
         2. Replace REPLACE_WITH_YOUR_FORMSPREE_ID below with your form ID
            (the 8-character code from your Formspree dashboard endpoint URL,
            e.g. https://formspree.io/f/abcd1234 → use "abcd1234").
         3. The _next hidden input redirects to /contact-success/ on submission.
    -->
    <form
      class="space-y-6"
      name="contact"
      method="POST"
      action="https://formspree.io/f/mnpanzjo"
      aria-label="Contact form"
    >
      <!-- Redirect to success page after submission -->
      <input type="hidden" name="_next" value="/contact-success/" />
      <!-- Optional: prevents Formspree's default spam filter email subject -->
      <input type="hidden" name="_subject" value="New contact message — Spoky Curates" />
      <!-- Required field note -->
      <p id="required-note" class="sr-only">Fields marked with an asterisk (*) are required.</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
        <div>
          <label for="name" class="block text-sm font-medium text-slate-700 mb-2">
            Name <span class="text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            id="name"
            type="text"
            name="name"
            required
            aria-required="true"
            aria-describedby="required-note"
            autocomplete="name"
            class="input"
            placeholder="Your name"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-medium text-slate-700 mb-2">
            Email <span class="text-red-500" aria-hidden="true">*</span>
          </label>
          <input
            id="email"
            type="email"
            name="email"
            required
            aria-required="true"
            aria-describedby="required-note"
            autocomplete="email"
            class="input"
            placeholder="you@example.com"
          />
        </div>
      </div>

      <div>
        <label for="subject" class="block text-sm font-medium text-slate-700 mb-2">
          Subject
        </label>
        <select id="subject" name="subject" class="input">
          <option value="">Select a topic…</option>
          <option value="general">General question</option>
          <option value="product-suggestion">Product suggestion</option>
          <option value="partnership">Partnership / PR inquiry</option>
          <option value="correction">Content correction</option>
          <option value="other">Other</option>
        </select>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-slate-700 mb-2">
          Message <span class="text-red-500" aria-hidden="true">*</span>
        </label>
        <textarea
          id="message"
          name="message"
          required
          aria-required="true"
          aria-describedby="required-note"
          rows="6"
          class="input resize-none"
          placeholder="Tell us how we can help…"
        ></textarea>
      </div>

      <button type="submit" class="btn-primary btn-lg">
        Send Message
      </button>
    </form>

  </div>
</BaseLayout>
