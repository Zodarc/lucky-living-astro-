---
import BaseLayout from '@layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';
import { buildCanonical } from '@utils/seo';

const comparisons = (await getCollection('comparisons', (entry) => !entry.data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const resolvedComparisons = (
  await Promise.all(
    comparisons.map(async (comparison) => ({
      comparison,
      productA: await getEntry('products', comparison.data.productA),
      productB: await getEntry('products', comparison.data.productB),
    }))
  )
).filter(({ productA, productB }) => productA && productB);
---

<BaseLayout
  title="Product Comparisons"
  description="Side-by-side product comparisons to help you choose the right smart-home and lifestyle upgrades."
  canonical={buildCanonical('/compare/')}
>
  <section class="relative py-16 lg:py-24 bg-slate-900 text-white">
    <div class="container">
      <p class="eyebrow text-amber-300 mb-3">Side by Side</p>
      <h1 class="font-serif text-4xl lg:text-5xl font-bold mb-4">Product Comparisons</h1>
      <p class="text-lg text-white/70 max-w-2xl">
        Clear, practical comparisons for choosing between products that compete for the same place in your home.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      {resolvedComparisons.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {resolvedComparisons.map(({ comparison, productA, productB }) => (
            <a
              href={`/compare/${comparison.slug}/`}
              class="group card flex flex-col overflow-hidden no-underline"
            >
              <div class="grid grid-cols-2 gap-2 p-4 bg-slate-50">
                <img
                  src={productA!.data.image}
                  alt={productA!.data.imageAlt || productA!.data.name}
                  class="w-full aspect-square object-contain rounded-xl bg-white p-3"
                  loading="lazy"
                />
                <img
                  src={productB!.data.image}
                  alt={productB!.data.imageAlt || productB!.data.name}
                  class="w-full aspect-square object-contain rounded-xl bg-white p-3"
                  loading="lazy"
                />
              </div>
              <div class="p-5">
                <p class="text-xs font-semibold uppercase tracking-wider text-amber-600 mb-2">
                  Comparison
                </p>
                <h2 class="font-serif text-xl font-bold text-slate-900 leading-snug group-hover:text-brand-accent">
                  {comparison.data.title}
                </h2>
                <p class="text-sm text-slate-500 leading-relaxed mt-3 line-clamp-3">
                  {comparison.data.description}
                </p>
              </div>
            </a>
          ))}
        </div>
      ) : (
        <p class="text-center text-slate-500 py-16">Comparisons are coming soon.</p>
      )}
    </div>
  </section>
</BaseLayout>