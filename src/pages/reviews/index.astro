---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductCard from '@components/ProductCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES } from '@data/categories';
import { buildCanonical } from '@utils/seo';

const products = await getCollection(
  'products',
  (entry) => !entry.data.draft
);
const categoryCounts = products.reduce(
  (counts, product) => {

    const category = product.data.category;

    counts[category] = (counts[category] ?? 0) + 1;

    return counts;

  },
  {} as Record<string, number>
);

const sort = Astro.url.searchParams.get("sort") ?? "rating";

let sortedProducts = [...products];

if (sort === "newest") {
  sortedProducts.sort(
    (a, b) =>
      b.data.publishDate.getTime() -
      a.data.publishDate.getTime()
  );
}

else if (sort === "featured") {
  sortedProducts.sort(
    (a, b) =>
      Number(b.data.featured) -
      Number(a.data.featured)
  );
}

else {
  // default: highest rated
  sortedProducts.sort(
    (a, b) =>
      (b.data.rating ?? 0) -
      (a.data.rating ?? 0)
  );
}
const selectedCategory = Astro.url.searchParams.get("category");

const filteredProducts = selectedCategory
  ? sortedProducts.filter(
      (product) =>
        product.data.category === selectedCategory
    )
  : sortedProducts;

const reviewCategories = [
  {
    name: "All",
    slug: "all",
    count: products.length
  },

  ...CATEGORIES
    .filter(cat =>
      [
        "smart-home",
        "tech-life",
        "wellness",
        "style",
        "deals"
      ].includes(cat.slug)
    )
    .filter(cat => categoryCounts[cat.slug] > 0)
    .map(cat => ({
      ...cat,
      count: categoryCounts[cat.slug] ?? 0
    }))
];

const canonical = buildCanonical('/reviews/');
---

<BaseLayout
  title="Product Reviews | Spoky Curates"
  description="Honest product reviews, ratings, and buying guides covering smart home, tech, wellness, and lifestyle products."
  canonical={canonical}
>

<section class="relative py-16 lg:py-24 bg-slate-900 text-white">

  <div class="container">

    <h1 class="font-serif text-4xl lg:text-5xl font-bold mb-4">
      Product Reviews
    </h1>

    <p class="text-lg text-white/70 max-w-2xl">
      Honest reviews, ratings, and buying advice to help you choose better products.
    </p>

  </div>

</section>
<section class="container py-10">

<div class="flex flex-wrap gap-3">

{reviewCategories.map((cat) => (

<a
href={
  cat.slug === "all"
    ? "/reviews/"
    : `/reviews/?category=${cat.slug}`
}
class="px-5 py-2 rounded-full border border-slate-200 hover:bg-slate-100 transition"
>

{cat.name} ({cat.count})
</a>

))}

</div>

</section>
<section class="container pb-8">

<div class="flex flex-wrap gap-3 items-center">

<span class="text-sm font-semibold text-slate-500">
Sort:
</span>

<a
href="/reviews/?sort=rating"
class="inline-flex items-center gap-2 px-4 py-2 rounded-full border hover:bg-slate-100"
>
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="w-4 h-4 text-amber-500"
  aria-hidden="true"
>
  <path d="m12 3 2.78 5.63 6.22.9-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.92 1.06-6.2L3 9.53l6.22-.9L12 3Z" />
</svg>
Highest Rated
</a>


<a
href="/reviews/?sort=newest"
class="inline-flex items-center gap-2 px-4 py-2 rounded-full border hover:bg-slate-100"
>
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="w-4 h-4 text-blue-500"
  aria-hidden="true"
>
  <circle cx="12" cy="12" r="8.5" />
  <path d="M12 7.5v5l3 2" />
</svg>
Newest
</a>


<a
href="/reviews/?sort=featured"
class="inline-flex items-center gap-2 px-4 py-2 rounded-full border hover:bg-slate-100"
>
<svg
  xmlns="http://www.w3.org/2000/svg"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class="w-4 h-4 text-emerald-600"
  aria-hidden="true"
>
  <path d="M20.5 13.5 13.5 20.5a2 2 0 0 1-2.8 0l-7.2-7.2a2 2 0 0 1 0-2.8L10.5 3.5H18a2 2 0 0 1 2 2v7.5Z" />
  <circle cx="15.5" cy="8.5" r="1" />
</svg>
Featured Deals
</a>

</div>

</section>

<section class="section bg-white">

<div class="container">

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">

{filteredProducts.map((product) => (  
  <ProductCard entry={product} />
))}

</div>

</div>

</section>

</BaseLayout>