---
import BaseLayout from '@layouts/BaseLayout.astro';
import { SITE } from '@data/site';
---

<BaseLayout
  title="Page Not Found"
  description={`The page you requested could not be found on ${SITE.name}.`}
  noindex={true}
  skipCanonical={true}
>
  <div class="container py-16 lg:py-24 max-w-2xl mx-auto text-center">

    <p class="text-sm font-semibold uppercase tracking-widest text-brand-accent mb-4">
      404
    </p>
    <h1 class="font-serif text-4xl lg:text-5xl font-bold text-slate-900 mb-4">
      Page Not Found
    </h1>
    <p class="text-lg text-slate-600 mb-8 leading-relaxed">
      The page you are looking for does not exist or may have been moved.
    </p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="btn-primary">Back to Home</a>
      <a href="/articles/" class="btn-outline-dark">Browse Articles</a>
    </div>

  </div>
</BaseLayout>
