---
import BaseLayout from '@layouts/BaseLayout.astro';
---

<BaseLayout
  title="Search | Spoky Curates"
  description="Search Spoky Curates articles, guides, and reviews."
>


<section class="section">

<div class="container">

<h1 class="section-title">
Search Spoky Curates
</h1>


<input
id="searchBox"
type="search"
placeholder="Search articles and reviews..."
class="input mt-8"
aria-label="Search articles and reviews"
/>

<!-- Live region: announces result count to screen readers -->
<p
  id="search-status"
  class="sr-only"
  aria-live="polite"
  aria-atomic="true"
></p>

<div id="results" class="mt-8 space-y-4">
</div>


</div>

</section>


<script>

const input = document.querySelector("#searchBox");
const results = document.querySelector("#results");
const status  = document.querySelector("#search-status");


let items = [];


fetch("/search.json")
.then(res => res.json())
.then(data => {
  items = data;
});


input.addEventListener("input", () => {

const query = input.value.toLowerCase().trim();


if(!query){
  results.innerHTML="";
  status.textContent = "";
  return;
}


const matches = items.filter(item => {

const text = [
 item.title,
 item.description,
 item.category,
 ...(item.tags || [])
]
.join(" ")
.toLowerCase();


return text.includes(query);

});


results.innerHTML = "";

if (!matches.length) {
  status.textContent = "No results found.";
  const empty = document.createElement("p");
  empty.className = "text-slate-500";
  empty.textContent = "No results found.";
  results.appendChild(empty);
} else {
  status.textContent = `${matches.length} ${matches.length === 1 ? 'result' : 'results'} found.`;
  for (const item of matches) {
    // <a>
    const a = document.createElement("a");
    a.href = item.url;
    a.className = "block rounded-xl border border-slate-200 p-5 hover:bg-slate-50";

    // <h2>
    const h2 = document.createElement("h2");
    h2.className = "font-bold text-lg";
    h2.textContent = item.title;

    // <p> meta line
    const meta = document.createElement("p");
    meta.className = "text-sm text-slate-500";
    meta.textContent = `${item.type} · ${item.category}`;

    // <p> description
    const desc = document.createElement("p");
    desc.className = "mt-2 text-slate-600";
    desc.textContent = item.description;

    a.appendChild(h2);
    a.appendChild(meta);
    a.appendChild(desc);
    results.appendChild(a);
  }
}

});

</script>


</BaseLayout>