---
import { buildFAQSchema } from '@utils/seo';

const faqItems = [
  {
    question: 'Are the links on Spoky Curates affiliate links?',
    answer:
      'Some links are affiliate links, which means Spoky Curates may earn a small commission if you make a purchase through them, at no extra cost to you. This helps support our independent editorial work. Our recommendations are not determined by commission rates.',
  },
  {
    question: 'How current are the prices shown on the site?',
    answer:
      'Prices are checked by our team and labeled with the date they were last verified. Retailer pricing, availability, promotions, and shipping costs can change, so always confirm the final price on the retailer page before purchasing.',
  },
  {
    question: 'How does Spoky Curates choose the products it reviews?',
    answer:
      'We look for products that offer meaningful value, useful design, dependable performance, and a good fit for everyday life. We combine hands-on evaluation when available with product research, specifications, customer feedback, and comparisons across the category.',
  },
  {
    question: 'How often do you check product prices?',
    answer:
      'We periodically recheck prices for products in our catalog, with extra attention to featured products and seasonal shopping periods. The Checked date on each product card shows the most recent verification we have recorded.',
  },
  {
    question: 'Can I suggest a product for review?',
    answer:
      'Yes. Send us the product name, a link to the product page, and what you would like us to evaluate through our contact page. We review suggestions based on reader interest, relevance, availability, and whether we can provide a useful independent assessment.',
  },
  {
    question: 'Do brands pay for positive reviews?',
    answer:
      'No. Brands cannot buy a positive rating or editorial recommendation. We may use affiliate links and may receive products for consideration, but our opinions and verdicts remain independent and our commercial relationships are disclosed.',
  },
];

const faqSchema = buildFAQSchema(faqItems);
---

<section class="section bg-slate-50" aria-labelledby="faq-heading">
  <script type="application/ld+json" set:html={faqSchema} />

  <div class="container">
    <div class="max-w-2xl mx-auto text-center mb-10 lg:mb-12">
      <p class="eyebrow mb-3" style="color: var(--color-brand-accent);">Good to Know</p>
      <h2
        id="faq-heading"
        class="font-serif text-3xl lg:text-4xl font-bold text-slate-900 tracking-tight mb-4"
      >
        Frequently Asked Questions
      </h2>
      <p class="text-slate-500 leading-relaxed">
        A little more about how we research, review, and share product recommendations.
      </p>
    </div>

    <div class="faq-list max-w-3xl mx-auto">
      {faqItems.map((item) => (
        <details class="faq-item group">
          <summary class="faq-summary">
            <span>{item.question}</span>
            <span class="faq-icon" aria-hidden="true">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14" />
                <path d="M5 12h14" />
              </svg>
            </span>
          </summary>
          <p class="faq-answer">{item.answer}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    overflow: hidden;
    border: 1px solid #E2E8F0;
    border-radius: 0.875rem;
    background: #FFFFFF;
    box-shadow: 0 3px 12px -8px rgb(15 23 42 / 0.2);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    cursor: pointer;
    list-style: none;
    padding: 1.25rem 1.5rem;
    color: #0F172A;
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:focus-visible {
    outline: 3px solid rgb(37 99 235 / 0.35);
    outline-offset: -3px;
  }

  .faq-icon {
    display: inline-flex;
    flex-shrink: 0;
    color: #64748B;
    transition: transform 180ms ease, color 180ms ease;
  }

  .faq-item[open] .faq-icon {
    transform: rotate(45deg);
    color: var(--color-brand-accent);
  }

  .faq-answer {
    margin: 0;
    border-top: 1px solid #F1F5F9;
    padding: 1rem 1.5rem 1.35rem;
    color: #64748B;
    font-size: 0.9375rem;
    line-height: 1.75;
  }

  @media (max-width: 640px) {
    .faq-summary {
      padding: 1.1rem 1.125rem;
      font-size: 1rem;
    }

    .faq-answer {
      padding: 0.875rem 1.125rem 1.15rem;
    }
  }
</style>