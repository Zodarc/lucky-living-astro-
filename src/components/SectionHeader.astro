---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  linkText?: string;
  linkHref?: string;
}

const {
  eyebrow,
  title,
  description,
  linkText,
  linkHref
} = Astro.props;
---

<div class="section-header-premium mb-10">

  <div class="flex items-end justify-between gap-6">

    <div>

      {eyebrow && (
        <p
          class="text-xs uppercase tracking-[0.3em] font-bold text-amber-600 mb-3"
          data-animate="fade"
        >
          {eyebrow}
        </p>
      )}

      <h2
        class="font-serif text-3xl lg:text-5xl font-bold text-slate-900 leading-tight"
        data-animate="fade-up"
        data-delay="100"
      >
        {title}
      </h2>

      {description && (
        <p
          class="mt-3 text-slate-500 max-w-xl text-base leading-relaxed"
          data-animate="fade-up"
          data-delay="200"
        >
          {description}
        </p>
      )}

    </div>


    {linkText && linkHref && (
      <a
        href={linkHref}
        class="hidden sm:inline-flex text-sm font-semibold text-slate-600 hover:text-slate-900 transition"
      >
        {linkText}
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="w-4 h-4"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m13 6 6 6-6 6" />
        </svg>
      </a>
    )}

  </div>

  <div
    class="mt-6 h-px w-24 bg-gradient-to-r from-transparent via-slate-300 to-transparent"
    data-animate="fade"
    data-delay="300"
  />

</div>